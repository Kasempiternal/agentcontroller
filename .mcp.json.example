{
  "_comment": "Copy to .mcp.json. .mcp.json is gitignored because some clients want a machine-specific absolute path. After `pip install -e Linux/`, python3 -m is enough.",
  "mcpServers": {
    "agentcontroller": {
      "command": "/Users/<you>/.agentcontroller/agentcontroller-mcp-bridge.sh"
    },
    "agentcontroller-linux": {
      "command": "python3",
      "args": ["-m", "agentcontroller_linux"]
    }
  }
}
